rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStAdelaideUser() {
      return request.auth != null && request.auth.token.email.matches('.*@stadelaideschool\\.com$');
    }

    match /lesson-plans/{userId}/{allPaths=**} {
      // Allow read if user owns the file or is an HOD
      allow read: if isStAdelaideUser() && (
        request.auth.uid == userId ||
        firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role == 'HOD'
      );
      allow write: if isStAdelaideUser() && request.auth.uid == userId;
    }
  }
}

